{
  "author": {
    "name": "German Bagdasaryan",
    "email": "german.bagdasaryan@mail.ru"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Poizon-API/goods-converter.git"
  },
  "bugs": {
    "url": "https://github.com/Poizon-API/goods-converter/issues"
  },
  "name": "goods-exporter",
  "version": "2.6.0",
  "description": "A versatile JavaScript library for exporting goods data to various formats such as YML, CSV, and Excel. Simplify data export tasks with ease. Supports streams.",
  "main": "./dist/cjs/index.cjs",
  "type": "module",
  "exports": {
    "require": "./dist/cjs/index.cjs",
    "import": "./dist/esm/index.mjs"
  },
  "types": "./dist/bundle.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c --watch",
    "test": "vitest",
    "lint": "eslint --ext .ts --fix",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "schema:fetch": "tsx scripts/fetch-avito-schema.ts",
    "schema:check": "tsx scripts/fetch-avito-schema.ts --check"
  },
  "keywords": [
    "stream",
    "yml",
    "json",
    "csv",
    "excel",
    "tilda",
    "tg-shop",
    "insales",
    "wocommerce",
    "items",
    "products",
    "goods",
    "export",
    "exporter",
    "tool",
    "yandex",
    "market"
  ],
  "dependencies": {
    "exceljs": "4.4.0",
    "fast-xml-parser": "4.4.1",
    "json-stream-stringify": "3.1.4",
    "sanitize-html": "2.17.4"
  },
  "devDependencies": {
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-multi-entry": "6.0.1",
    "@rollup/plugin-typescript": "11.1.6",
    "@types/node": "24.12.0",
    "@types/sanitize-html": "2.16.1",
    "@types/xml": "1.0.11",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@vitest/coverage-v8": "2.0.5",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-config-standard-with-typescript": "39.1.1",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-n": "16.6.2",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-promise": "6.6.0",
    "eslint-plugin-unused-imports": "3.2.0",
    "prettier": "3.3.3",
    "rollup": "4.20.0",
    "rollup-plugin-dts": "6.1.1",
    "rollup-plugin-esbuild": "6.1.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "tsx": "4.22.3",
    "typescript": "5.5.4",
    "vitest": "2.0.5"
  },
  "engines": {
    "node": ">= 18"
  },
  "license": "MIT"
}
